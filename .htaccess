# ==========================================================================
# Alexo — configuration Apache (Hostinger)
# Ce fichier doit rester à la racine du site (public_html/).
# ==========================================================================

# --- Forcer HTTPS et le domaine sans www -----------------------------------
# Actif depuis l'installation du certificat SSL.
# En cas de « trop de redirections », remettre les # devant les 6 lignes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://alexowebdesign.com%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Page d'erreur personnalisée -------------------------------------------
ErrorDocument 404 /404.html

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache navigateur ------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# --- En-têtes de sécurité --------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # Pas de includeSubDomains (un sous-domaine Hostinger non-HTTPS casserait) ni
  # de preload (quasi irréversible) — juste forcer HTTPS sur ce domaine.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- Ne pas lister le contenu des dossiers ---------------------------------
Options -Indexes

# --- Fichiers de dépôt à ne pas servir -------------------------------------
# La racine du dépôt est aussi la racine du site : sans ces règles,
# /README.md ou /docs/... seraient consultables publiquement.
RedirectMatch 404 ^/(README\.md|\.git|\.gitignore|docs|brand)(/|$)
